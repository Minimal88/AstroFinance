# The AstroFinance spreadsheet ID, from its URL:
# docs.google.com/spreadsheets/d/<THIS_PART>/edit
SPREADSHEET_ID=REPLACE_WITH_YOUR_SPREADSHEET_ID

# Day of month your credit card billing period closes.
BILLING_CUTOFF_DAY=15

# Service account key. Share the Sheet with this account's email address,
# otherwise every API call returns 404.
GOOGLE_SERVICE_ACCOUNT_PATH=credentials/service_account.json

ASTROFINANCE_DB_PATH=data/astrofinance.db

# Tab names, only if you renamed them.
TRANSACTIONS_TAB=Transactions
PAYMENTS_TAB=Payments
